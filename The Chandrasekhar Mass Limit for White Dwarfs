    "def dX_dr(r, X): # argument order changed # \n",
    "    if r == 0:\n",
    "        return np.array([0, 0]) #  return X[0] or 0 # \n",
    "    e_density = (X[0]/K_nr)**(3/5)\n",
    "    density = e_density/c**2\n",
    "    dpdr = -G*density*X[1]/(r**2)\n",
    "    dMdr = 4*pi*(r**2)*density\n",
    "    return np.array([dpdr, dMdr])\n",
    "\n",
    "def dX2_dr(r, X2):\n",
    "    if r == 0:\n",
    "        return np.array([0, 0])\n",
    "    e_density = (X2[0]/K_r)**(3/4)\n",
    "    density = e_density/c**2\n",
    "    dpdr = -G*density*X2[1]/(r**2)\n",
    "    dMdr = 4*pi*(r**2)*density\n",
    "    return np.array([dpdr, dMdr])"
   ]
