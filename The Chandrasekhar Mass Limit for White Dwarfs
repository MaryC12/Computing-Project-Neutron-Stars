   "source": [
    "AZ = 2\n",
    "G = 6.6743*10**-11\n",
    "h_bar = 1.054571817*10**-34\n",
    "pi = np.pi\n",
    "m_e = 9.1093837*10**-31\n",
    "m_p = 1.672621898*10**-27\n",
    "m_Sun = 1.989*10**30\n",
    "c = 299792458\n",
    "r_Sun = 696340000\n",
    "\n",
    "K_nr = (h_bar**2/(15*pi**2*m_e))*(3*pi**2/(AZ*m_p*c**2))**(5/3)\n",
    "K_r = (h_bar*c/(12*pi**2))*(3*pi**2/(AZ*m_p*c**2))**(4/3)\n",
    "\n",
    "def e_d(d):\n",
    "    return d*c**2\n",
    "def p_nr(d):\n",
    "    return K_nr*e_d(d)**(5/3)\n",
    "def p_r(d):\n",
    "    return K_r*e_d(d)**(4/3)\n",
    "\n",
    "def k_f(d):\n",
    "    a = (3*pi**2*d)/(AZ*m_p)\n",
    "    return h_bar*a**(1/3)"
   ]
